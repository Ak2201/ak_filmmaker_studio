{
  "name": "filmmakers-studio",
  "version": "1.0.0",
  "description": "A working desk for screenwriting, pre-production and craft study.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:open": "VITE_SITE_GATE=off vite build",
    "build:extension": "node scripts/build-extension.mjs",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "extract": "node scripts/extract/feature-steps.mjs && node scripts/extract/short-steps.mjs && node scripts/extract/library.mjs && node scripts/extract/relink.mjs",
    "verify": "node scripts/verify-migration.mjs",
    "test:pdf": "node scripts/test-pdf-text.mjs",
    "test:story": "node scripts/test-story.mjs",
    "test:screenplay": "node scripts/test-screenplay.mjs",
    "test:billing": "node scripts/test-billing.mjs",
    "test:schema": "node scripts/test-schema.mjs",
    "test:post": "node scripts/test-post.mjs",
    "test:format": "node scripts/test-format.mjs",
    "test:beats": "node scripts/test-beats.mjs",
    "test:tanglish": "node scripts/test-tanglish.mjs",
    "ship": "npm run build:open && npm run verify && npm run build && npm run prove:gate",
    "live-checks": "node scripts/live-checks.mjs",
    "prove:drive": "node scripts/prove-drive.mjs",
    "prove:storage": "node scripts/prove-storage.mjs",
    "prove:gate": "node scripts/prove-gate.mjs",
    "prove:extension": "node scripts/prove-extension.mjs",
    "prove:billing": "node scripts/prove-billing.mjs",
    "baseline": "node scripts/verify-migration.mjs --baseline",
    "density": "node scripts/density.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ak2201/ak_filmmaker_studio.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Ak2201/ak_filmmaker_studio/issues"
  },
  "homepage": "https://github.com/Ak2201/ak_filmmaker_studio#readme",
  "devDependencies": {
    "linkedom": "^0.18.13",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "pptxgenjs": "^4.0.1"
  },
  "private": true,
  "type": "module"
}
