{
  "name": "filmmakers-studio",
  "version": "1.0.0",
  "description": "A working desk for screenwriting, pre-production and craft study.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:open": "VITE_SITE_GATE=off vite build",
    "build:extension": "node scripts/build-extension.mjs",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "og": "node scripts/make-og.mjs",
    "extract": "node scripts/extract/feature-steps.mjs && node scripts/extract/short-steps.mjs && node scripts/extract/library.mjs && node scripts/extract/relink.mjs",
    "verify": "node scripts/verify-migration.mjs",
    "test:pdf": "node scripts/test-pdf-text.mjs",
    "test:story": "node scripts/test-story.mjs",
    "test:videos": "node scripts/test-videos.mjs",
    "test:videos:online": "node scripts/check-videos-online.mjs",
    "test:screenplay": "node scripts/test-screenplay.mjs",
    "test:billing": "node scripts/test-billing.mjs",
    "test:invoice": "node scripts/test-invoice.mjs",
    "test:schema": "node scripts/test-schema.mjs",
    "test:post": "node scripts/test-post.mjs",
    "test:format": "node scripts/test-format.mjs",
    "test:delivery": "node scripts/test-delivery.mjs",
    "test:beats": "node scripts/test-beats.mjs",
    "test:tanglish": "node scripts/test-tanglish.mjs",
    "test:keys": "node scripts/test-keys.mjs",
    "test:shots": "node scripts/test-shots.mjs",
    "test:sync": "node scripts/test-sync.mjs",
    "test:stripboard": "node scripts/test-stripboard.mjs",
    "test:import": "node scripts/test-import.mjs",
    "test:sun": "node scripts/test-sun.mjs",
    "test:callsheet": "node scripts/test-callsheet.mjs",
    "test:costs": "node scripts/test-costs.mjs",
    "test:revisions": "node scripts/test-revisions.mjs",
    "test:ai-coverage": "node scripts/test-ai-coverage.mjs",
    "test:testimonials": "node scripts/check-testimonials.mjs",
    "shots": "node scripts/make-shots.mjs",
    "test:brand": "node scripts/check-brand.mjs",
    "test:all": "npm run test:brand && npm run test:pdf && npm run test:story && npm run test:screenplay && npm run test:billing && npm run test:invoice && npm run test:schema && npm run test:post && npm run test:format && npm run test:delivery && npm run test:beats && npm run test:tanglish && npm run test:keys && npm run test:shots && npm run test:sync && npm run test:stripboard && npm run test:import && npm run test:sun && npm run test:callsheet && npm run test:costs && npm run test:revisions && npm run test:ai-coverage && npm run test:testimonials && npm run test:videos && npm run test:money && npm run test:plans",
    "build:verify": "VITE_SITE_GATE=off vite build --outDir dist-verify",
    "test:ai-lazy": "node scripts/check-ai-lazy.mjs",
    "ship": "npm run test:all && npm run build:open && npm run verify && npm run prove:adoption && npm run build && npm run test:ai-lazy && npm run prove:gate && npm run prove:billing && npm run prove:storage && npm run prove:drive && npm run prove:sw && npm run build:extension && npm run prove:extension && npm run build:verify && npm run prove:growth && npm run prove:ai-coverage",
    "live-checks": "node scripts/live-checks.mjs",
    "prove:drive": "node scripts/prove-drive.mjs",
    "prove:storage": "node scripts/prove-storage.mjs",
    "prove:gate": "node scripts/prove-gate.mjs",
    "prove:extension": "node scripts/prove-extension.mjs",
    "prove:billing": "node scripts/prove-billing.mjs",
    "prove:sw": "node scripts/prove-sw.mjs",
    "prove:growth": "node scripts/prove-growth.mjs",
    "test:money": "node scripts/test-money.mjs",
    "test:plans": "node scripts/test-plans.mjs",
    "prove:adoption": "node scripts/prove-adoption.mjs",
    "prove:ai-coverage": "node scripts/prove-ai-coverage.mjs",
    "baseline": "node scripts/verify-migration.mjs --baseline",
    "density": "node scripts/density.mjs",
    "demo": "node scripts/make-demo.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ak2201/ak_filmmaker_studio.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Ak2201/ak_filmmaker_studio/issues"
  },
  "homepage": "https://github.com/Ak2201/ak_filmmaker_studio#readme",
  "devDependencies": {
    "linkedom": "^0.18.13",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "pptxgenjs": "^4.0.1"
  },
  "private": true,
  "type": "module"
}
