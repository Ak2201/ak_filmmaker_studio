      "type": "raw",
      "html": "<div class=\"calc-block\"> <h3>Quick Cost Estimator</h3> <p class=\"hint\">Add line items, set days × daily rate, get a running total. Saves to your browser only. Click PRINT to keep a hard copy.</p> <div class=\"calc-row head\"> <span>Item</span><span>Days</span><span>Rate (₹/day)</span><span>Subtotal</span> </div> <div id=\"calcRows\"></div> <div class=\"calc-actions\"> <button class=\"mini-btn\" onclick=\"addCalcRow()\">+ ADD ITEM</button> <button class=\"mini-btn\" onclick=\"addCalcRow(5)\">+ ADD 5</button> <button class=\"mini-btn danger\" onclick=\"resetCalc()\">RESET</button> </div> <div class=\"calc-grand\"> <span class=\"lab\">GRAND TOTAL</span> <span class=\"total\" id=\"calcTotal\">₹ 0 <span>across 0 line items</span></span> </div> </div>"
    }
