{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/marketing/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; font-src 'self'; img-src 'self' data: blob: https://*.razorpay.com https://*.googleusercontent.com; media-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.anthropic.com https://generativelanguage.googleapis.com https://www.googleapis.com https://accounts.google.com/gsi/ https://api.razorpay.com https://lumberjack.razorpay.com https://checkout.razorpay.com; frame-src 'self' https://accounts.google.com/gsi/ https://api.razorpay.com https://checkout.razorpay.com https://www.youtube-nocookie.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/studio", "destination": "/" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/budget", "destination": "/budget.html" },
    { "source": "/feature", "destination": "/feature.html" },
    { "source": "/short", "destination": "/short.html" },
    { "source": "/library", "destination": "/library.html" },
    { "source": "/breakdown", "destination": "/breakdown.html" },
    { "source": "/stripboard", "destination": "/stripboard.html" },
    { "source": "/reports", "destination": "/reports.html" },
    { "source": "/contacts", "destination": "/contacts.html" },
    { "source": "/visualize", "destination": "/visualize.html" },
    { "source": "/write", "destination": "/write.html" },
    { "source": "/screenplay", "destination": "/screenplay.html" },
    { "source": "/plan", "destination": "/plan.html" },
    { "source": "/study", "destination": "/study.html" },
    { "source": "/dissect", "destination": "/dissect.html" },
    { "source": "/settings", "destination": "/settings.html" },
    { "source": "/shoot", "destination": "/shoot.html" },
    { "source": "/edit", "destination": "/edit.html" },
    { "source": "/deliverables", "destination": "/deliverables.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/refund", "destination": "/refund.html" },
    { "source": "/start", "destination": "/start.html" },
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/product-writing", "destination": "/product-writing.html" },
    { "source": "/product-story", "destination": "/product-story.html" },
    { "source": "/product-storyboard", "destination": "/product-storyboard.html" },
    { "source": "/product-breakdown", "destination": "/product-breakdown.html" },
    { "source": "/product-catalog", "destination": "/product-catalog.html" },
    { "source": "/product-shot-list", "destination": "/product-shot-list.html" },
    { "source": "/product-schedule", "destination": "/product-schedule.html" },
    { "source": "/product-budget", "destination": "/product-budget.html" },
    { "source": "/product-call-sheets", "destination": "/product-call-sheets.html" },
    { "source": "/product-cast-crew", "destination": "/product-cast-crew.html" },
    { "source": "/product-sides", "destination": "/product-sides.html" },
    { "source": "/guides", "destination": "/guides.html" },
    { "source": "/guide-call-sheet", "destination": "/guide-call-sheet.html" },
    { "source": "/guide-tamil-screenplay-format", "destination": "/guide-tamil-screenplay-format.html" },
    { "source": "/guide-short-film-budget", "destination": "/guide-short-film-budget.html" },
    { "source": "/guide-script-breakdown", "destination": "/guide-script-breakdown.html" },
    { "source": "/guide-cbfc-checklist", "destination": "/guide-cbfc-checklist.html" },
    { "source": "/guide-ott-delivery", "destination": "/guide-ott-delivery.html" },
    { "source": "/guide-festival-planner", "destination": "/guide-festival-planner.html" },
    { "source": "/compare-celtx", "destination": "/compare-celtx.html" },
    { "source": "/compare-final-draft", "destination": "/compare-final-draft.html" },
    { "source": "/trust", "destination": "/trust.html" }
  ],
  "redirects": [
    { "source": "/script.html", "destination": "/screenplay", "permanent": true },
    { "source": "/script", "destination": "/screenplay", "permanent": true },
    { "source": "/shared/:token", "destination": "/?share=:token", "permanent": false },
    { "source": "/arunak-filmmaker-blueprint.html", "destination": "/feature", "permanent": true },
    { "source": "/arunak-shortfilm-blueprint.html", "destination": "/short", "permanent": true },
    { "source": "/arunak-filmmaker-library.html", "destination": "/library", "permanent": true }
  ]
}
